  "headers": {
    "verif-hash": "kielsync-conformance-verif-hash"
  },
  "expected": {
    "signature_valid": true,
    "event_id": null,
    "event_type": "charge.completed",
    "gateway_reference": "kiel_txn_0002",
    "status": "SUCCESS",
    "amount": 500000,
    "currency": "NGN"
  }
}
